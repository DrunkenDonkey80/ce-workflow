{
  "schemaVersion": 1,
  "release": "compound-engineering-v3.23.4",
  "scanRoots": [
    "extensions",
    "agents",
    "skills",
    "scripts",
    "package.json",
    "README.md"
  ],
  "excludePaths": [
    "extensions/private-workflows/brainstorm.md",
    "extensions/private-workflows/browser.md",
    "extensions/private-workflows/debug.md",
    "extensions/private-workflows/explain.md",
    "extensions/private-workflows/ideate.md",
    "extensions/private-workflows/learning.md",
    "extensions/private-workflows/manifest.json",
    "extensions/private-workflows/plan.md",
    "extensions/private-workflows/pov.md",
    "extensions/private-workflows/provenance.json",
    "extensions/private-workflows/review.md",
    "extensions/private-workflows/simplify.md",
    "extensions/work-compound-inventory.json",
    "extensions/work-compound-source-policy.json",
    "extensions/work-compound-source.js",
    "extensions/work-private-workflows.js",
    "scripts/generate-work-private-workflows.mjs",
    "scripts/probe-work-compound-source.mjs",
    "scripts/test-work-compound-source.mjs",
    "scripts/test-work-private-workflows.mjs"
  ],
  "expectedMentions": {
    "extensions/work-models.js": {
      "ce-ideate": 1,
      "ce-plan": 1
    },
    "scripts/test-work-fleet.mjs": {
      "ce-plan": 2
    },
    "scripts/test-work-settings.mjs": {
      "ce-plan": 5
    },
    "scripts/test-work-start-finish.mjs": {
      "ce-plan": 2
    },
    "scripts/test-work-telemetry.mjs": {
      "ce-compound": 1
    },
    "skills/work-orchestrator/references/full-policy.md": {
      "ce-ideate": 1
    }
  },
  "parityIndex": {
    "ce-brainstorm": {
      "trigger": "/wo Brainstorm and fallback brainstorm policy",
      "decisions": "interactive clarification and artifact verdict",
      "toolBoundary": "read/research and brainstorm artifact write",
      "artifacts": "linked brainstorm markdown or HTML",
      "failure": "stop without silently inventing requirements",
      "actorVisibleOutcome": "requirements artifact and work-item backlink"
    },
    "ce-plan": {
      "trigger": "/wo Plan, master/slice planning, migration consolidation",
      "decisions": "clarifications, open-question gate, scope mapping",
      "toolBoundary": "repository reads and plan artifact/work-item planning writes",
      "artifacts": "versioned plan plus roadmap planning state",
      "failure": "block roadmap bootstrap on unresolved questions",
      "actorVisibleOutcome": "hardened plan and next coded action"
    },
    "ce-code-review": {
      "trigger": "max-profile pre-commit review gate",
      "decisions": "blocking finding classification and bounded re-review",
      "toolBoundary": "scoped diff and read-only review tools",
      "artifacts": "review findings and PASS evidence",
      "failure": "do not commit or close",
      "actorVisibleOutcome": "actionable findings or review PASS"
    },
    "ce-simplify-code": {
      "trigger": "non-trivial simplify-before-review gate",
      "decisions": "remove duplication/dead flexibility without behavior change",
      "toolBoundary": "scoped implementation diff",
      "artifacts": "simplified source diff",
      "failure": "leave verified behavior unchanged",
      "actorVisibleOutcome": "smaller equivalent implementation"
    },
    "ce-test-browser": {
      "trigger": "UI-diff browser verification gate",
      "decisions": "affected pages and blocking UI failures",
      "toolBoundary": "runnable web UI and browser tools",
      "artifacts": "browser evidence",
      "failure": "block commit unless evidence-only waiver applies",
      "actorVisibleOutcome": "verified affected UI"
    },
    "ce-pov": {
      "trigger": "catch-up actionable candidate review",
      "decisions": "adopt, defer, or reject",
      "toolBoundary": "upstream evidence and current repository call sites",
      "artifacts": "graded catch-up verdict",
      "failure": "candidate does not advance",
      "actorVisibleOutcome": "concise adoption recommendation"
    },
    "ce-explain": {
      "trigger": "catch-up candidate too technical for concise POV",
      "decisions": "whether deeper explanation is required",
      "toolBoundary": "read-only candidate evidence",
      "artifacts": "optional technical explanation",
      "failure": "return to undecided catch-up state",
      "actorVisibleOutcome": "decision-ready explanation"
    },
    "ce-debug": {
      "trigger": "work-debugger bug investigation",
      "decisions": "root cause, safe fix, verification, escalation",
      "toolBoundary": "assigned bug scope and smallest reproduction",
      "artifacts": "fix, verification, failure/debug evidence",
      "failure": "block and preserve exact reproduction evidence",
      "actorVisibleOutcome": "verified root-cause fix or explicit blocker"
    },
    "ce-compound": {
      "trigger": "post-fix or big-work learning capture",
      "decisions": "durable learning worth and destination",
      "toolBoundary": "project instructions, executable config, or docs/solutions",
      "artifacts": "deduplicated learning plus work-item key",
      "failure": "skip capture rather than duplicate",
      "actorVisibleOutcome": "durable non-obvious learning"
    },
    "ce-ideate": {
      "trigger": "work-ideate topic handoff",
      "decisions": "which ideas survive critique",
      "toolBoundary": "read-only repository grounding",
      "artifacts": "ideas JSON block captured as wo:idea work items",
      "failure": "recovery decision work item preserves raw output",
      "actorVisibleOutcome": "ranked Ideas dashboard"
    }
  }
}
