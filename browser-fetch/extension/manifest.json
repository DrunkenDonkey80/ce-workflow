{
  "manifest_version": 3,
  "name": "Pi browser fetch",
  "version": "1.5",
  "description": "Lets your Pi agent read pages in this browser after you approve each site. Click the icon to pause.",
  "key": "",
  "icons": { "32": "icon.png" },
  "action": { "default_title": "Pi browser fetch: on (click to pause)", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["nativeMessaging", "tabs", "scripting", "declarativeNetRequest", "webRequest", "storage", "alarms", "debugger", "tabGroups"],
  "host_permissions": ["<all_urls>"]
}
