{
  "name": "pi-work-orchestrator",
  "version": "0.1.52",
  "description": "Plan3 planning and execution, research mode, compaction and utility tools for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "workflow"
  ],
  "files": [
    "utility-agents/",
    "benchmarks/",
    "extensions/",
    "scripts/",
    "skills/",
    "hub/",
    "README.md"
  ],
  "scripts": {
    "audit:payload-strip": "node scripts/audit-payload-strip.mjs",
    "benchmark:image-strip": "node scripts/benchmark-image-strip-live.mjs",
    "benchmark:reasoning-strip": "node scripts/benchmark-reasoning-strip-live.mjs",
    "verify": "node scripts/verify-package.mjs",
    "verify:quiet": "node scripts/verify-package.mjs --quiet"
  },
  "pi": {
    "extensions": [
      "extensions/work-models.ts",
      "extensions/plan3.ts",
      "extensions/screen-read.ts",
      "extensions/enter-runs.ts",
      "extensions/advisor-model.ts",
      "extensions/ask-user/index.ts"
    ],
    "skills": [
      "./skills/frontend-design"
    ],
    "subagents": {
      "agents": [
        "./utility-agents"
      ]
    }
  },
  "dependencies": {
    "jiti": "2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-intercom": "*",
    "pi-subagents": ">=0.75.0"
  },
  "peerDependenciesMeta": {
    "pi-intercom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@sinclair/typebox": "0.34.41",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
