diff --git a/tests/test_seller_feedback.py b/tests/test_seller_feedback.py
new file mode 100644
index 0000000..239cfa2
--- /dev/null
+++ b/tests/test_seller_feedback.py
@@ -0,0 +1,13 @@
+from dealfinder.sync import chk2
+
+CONFIG = {"min_seller_feedback_pct": 98}
+
+
+def seller(pct):
+    return {"seller_feedback_pct": pct, "price_eur": 100.0}
+
+
+def test_low_feedback_seller_skipped_and_good_seller_kept():
+    listings = [seller(97.9), seller(98.0), seller(99.5)]
+    assert sum(1 for listing in listings if chk2(listing, CONFIG)) == 2
+    assert not chk2(seller(90), CONFIG)
